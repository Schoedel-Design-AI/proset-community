# Proset CE — environment configuration
# Copy to `.env` and fill in. All values are YOUR OWN — Proset CE is
# bring-your-own-everything: your AI keys, your Firebase project, your email.

# =============================================================================
# CORE (required)
# =============================================================================

# Public URL the app is served at (used for links/emails)
PUBLIC_APP_URL=http://localhost:5000
AIFORMS_PUBLIC_DOMAIN=localhost

# Server
NODE_ENV=production
PORT=5000

# Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me

# AI transcription + conversion — set at least ONE provider key
# (the app picks a provider via TRANSCRIBE_PROVIDER; hosted Proset uses all)
# TRANSCRIBE_PROVIDER=openai|groq|deepseek|mistral|fireworks
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
AI_FIREWORKS_API_KEY=

# Firebase (auth + database). Create a Firebase project, enable
# Authentication (Email/Password) + Firestore, download a service account.
FIREBASE_AUTH_MODE=legacy
FIREBASE_PROJECT_ID=
# Service account JSON path (Firebase Admin SDK)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Web client config (app auth) — from Firebase Console → Project settings
AIFORMS_PUBLIC_FIREBASE_API_KEY=
AIFORMS_PUBLIC_FIREBASE_AUTH_DOMAIN=
AIFORMS_PUBLIC_FIREBASE_PROJECT_ID=
AIFORMS_PUBLIC_FIREBASE_STORAGE_BUCKET=
AIFORMS_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
AIFORMS_PUBLIC_FIREBASE_APP_ID=

# Email (verification + password reset) — SendGrid or any SMTP-compatible key
SENDGRID_API_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================

# Object storage — defaults to LOCAL DISK (./.local/object-storage) if unset.
# For S3-compatible storage:
# OBJECT_STORAGE_PROVIDER=aws|minio|r2
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Turnstile captcha (register/support) — leave unset to disable
# AIFORMS_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Dev helpers
# LOG_LEVEL=info
# DISABLE_RATE_LIMIT=false
# USE_FIREBASE_IN_DEV=false

# ---------------------------------------------------------------------------
# INTEGRATIONS (leave unset unless you use them)
# ---------------------------------------------------------------------------
# ELEVENLABS_API_KEY=            # voice/avatars
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET          # calendar/connectors OAuth
# MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET    # connectors
# DROPBOX_APP_KEY / DROPBOX_APP_SECRET / DROPBOX_ACCESS_TOKEN
# BOX_ACCESS_TOKEN
# SHAREPOINT_ACCESS_TOKEN
# HUBSPOT_ACCESS_TOKEN
# GITHUB_TOKEN / GITHUB_REPO                        # feedback connector
# GITLAB_URL / GITLAB_TOKEN / GITLAB_PROJECT_ID
# DISCORD_BOT_TOKEN
# AUTH_MAGIC_LINK_ENABLED=false
# BACKUP_OAUTH_STATE_SECRET / BACKUP_PROVIDER_CONFIG_KEY / DB_ENCRYPTION_KEY
# CLOUD_TASKS_LOCATION / THOUGHT_THREAD_TASK_*     # hosted queue worker (unused in CE)

# ---------------------------------------------------------------------------
# REMOVED FROM CE (hosted Proset only — do not set):
#   STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / REVENUECAT_* / SUPER_ADMIN_PASSWORD
# ---------------------------------------------------------------------------
