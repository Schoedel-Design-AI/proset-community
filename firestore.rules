rules_version = '2';

// AIFor.ms Firestore security rules.
//
// IMPORTANT: In this app, Firestore is accessed ONLY server-side, by the
// Express/Cloud Run backend using the Firebase Admin SDK (Application Default
// Credentials in project barry-ai-native). The Admin SDK bypasses these rules
// entirely. No client (mobile or web) connects to Firestore directly — the
// clients talk to the backend over HTTP and authenticate with better-auth, not
// Firebase Auth. There is no google-services.json bundled in the app.
//
// Therefore the correct and safe posture is to DENY all direct client access.
// This matches the rules currently live on the barry-ai-native project.
//
// If direct client-to-Firestore access with Firebase Auth is ever introduced,
// add per-collection rules keyed on request.auth.uid and deploy them with:
//   firebase deploy --only firestore:rules --project barry-ai-native
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
