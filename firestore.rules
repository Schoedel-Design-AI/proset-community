rules_version = '2';

// Proset Community Edition — Firestore security rules.
//
// In Proset, Firestore is accessed ONLY server-side, by the backend using the
// Firebase Admin SDK (your own service account). The Admin SDK bypasses these
// rules entirely. No client (mobile or web) connects to Firestore directly —
// clients talk to the backend over HTTP and authenticate with server sessions.
// There is no google-services.json bundled in the app.
//
// Therefore the correct and safe posture is to DENY all direct client access.
// If you ever introduce direct client-to-Firestore access with Firebase Auth,
// add per-collection rules keyed on request.auth.uid and deploy them with:
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
